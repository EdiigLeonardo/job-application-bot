{
  "name": "job-application-bot",
  "version": "1.0.0",
  "description": "Automated, resilient job application bot using Playwright, Gemini, and BullMQ.",
  "main": "dist/app.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
